+        const outputPath = path.join(distRoot, cacheVersion, 'output');
+        const libPath = path.join(outputPath, outputFile);
+
+        // Belt and braces: the resolved path must still be inside outputPath.
+        const resolvedOutput = path.resolve(outputPath);
+        const resolvedLib = path.resolve(libPath);
+        if (resolvedLib !== path.join(resolvedOutput, outputFile) || !resolvedLib.startsWith(resolvedOutput + path.sep)) {
+            throw new Error(
+                `[P1] Resolved prebuilt path escapes its cache directory: ${resolvedLib} (expected under ${resolvedOutput}).`,
+            );
+        }
