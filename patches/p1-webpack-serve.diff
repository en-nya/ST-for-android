+     * Locate and verify the prebuilt lib.js described by dist/_webpack/BUILD.json.
+     *
+     * @param {string} [distRoot] Override for the dist root (defaults to <cwd>/dist/_webpack).
+     * @returns {{ outputPath: string, outputFile: string, size: number }}
+     * @throws {Error} If the manifest is missing, or the described artifact is absent/altered.
+     */
+    devMiddleware.usePrebuiltLib = (distRoot = path.resolve(process.cwd(), 'dist', '_webpack')) => {
+        const manifest = readBuildManifest(distRoot);
+
+        if (!manifest) {
+            throw new Error(
+                `[P1] No ${MANIFEST_NAME} under ${distRoot}. The packaging step must run ` +
+                '`node ./docker/build-lib.js`, which compiles dist/_webpack/<hash>/output/lib.js ' +
+                'and writes the manifest describing it. Refusing to guess which file to serve ' +
+                '(note: upstream .gitignore and .dockerignore both contain /dist — the packaging ' +
+                'step must un-ignore it).',
+            );
+        }
+
+        const cacheVersion = typeof manifest.cacheVersion === 'string' ? manifest.cacheVersion.trim() : '';
+        const outputFile = typeof manifest.filename === 'string' && manifest.filename
+            ? manifest.filename
+            : 'lib.js';
+
+        if (!cacheVersion) {
+            throw new Error(
+                `[P1] ${MANIFEST_NAME} under ${distRoot} has no "cacheVersion". ` +
+                'Regenerate it with `node ./docker/build-lib.js`.',
+            );
+        }
+
+        // Reject a cacheVersion that would escape the dist root (defence in depth: the
+        // manifest is build output, but it is read from a writable install tree).
+        if (cacheVersion.includes('..') || cacheVersion.includes('/') || cacheVersion.includes('\\')) {
+            throw new Error(`[P1] ${MANIFEST_NAME} has an unsafe cacheVersion: ${JSON.stringify(cacheVersion)}.`);
+        }
+
+        // Same check for `filename`. Without it, a crafted manifest could point at any file
+        // on the device (e.g. "../../../README.md"). The ENOENT on a missing target would
+        // accidentally save us — that is not a defence, it is luck. Validate structurally.
+        if (outputFile.includes('..') || outputFile.includes('/') || outputFile.includes('\\')) {
+            throw new Error(`[P1] ${MANIFEST_NAME} has an unsafe filename: ${JSON.stringify(outputFile)}.`);
+        }
