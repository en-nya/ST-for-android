+        const result = verify(libPath, manifest);
+        if (!result.ok) {
+            throw new Error(
+                `[P1] Prebuilt frontend library described by ${MANIFEST_NAME} is not usable: ` +
+                `${result.reason} (${libPath}). Refusing to serve an unverified bundle; ` +
+                'rerun `node ./docker/build-lib.js`.',
+            );
+        }
+
+        const size = fs.statSync(libPath).size;
+        prebuilt = { outputPath, outputFile, size };
+
+        console.log(
+            `Serving prebuilt frontend library: ${libPath} ` +
+            `(${(size / 1024 / 1024).toFixed(2)} MiB, sha256-verified)`,
+        );
+
+        return prebuilt;
+    };
