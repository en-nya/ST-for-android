+/**
+ * [ANDROID-PORT PATCH P1 v3] Boot-time webpack compile removed.
+ *
+ * Upstream imports `webpack` and `../../webpack.config.js` at module load time, and that
+ * config module does a top-level `await getVersion()` (which shells out to `git`), then
+ * `preSetupTasks()` runs a full production webpack compile before `listen`. On the
+ * reference desktop that is ~13s of compiler CPU per boot; on a phone it is minutes.
+ *
+ * The very same artifact is produced once at package time by `docker/build-lib.js`
+ * (`runWebpackCompiler({ forceDist: true })`) and shipped as
+ *   dist/_webpack/<cacheVersion>/output/lib.js
+ * so at runtime we only need to *locate* that file and serve it.
+ *
+ * ── Why v3 (read this before "simplifying" it back) ──────────────────────────────
+ * v1 picked the newest mtime. DEMONSTRATED BUG: a stale/partial cache dir with a newer
+ * mtime won and was served as a truncated 4,096-byte lib.js with HTTP 200 — a blank UI
+ * that logs success. Silent-wrong, the worst possible failure mode.
+ *
+ * v2 replaced that with content heuristics (min size + webpack banner + `export{` tail).
+ * ADVERSARIAL TESTING BROKE IT BOTH WAYS:
+ *   - FALSE ACCEPT: a 300 KB stub consisting of a valid banner + padding + `export{a as b};`
+ *     passed every check.
+ *   - FALSE REJECT: a legitimate bundle with `export {` (space) failed; a legitimate
+ *     bundle with a sourcemap comment pushing the export >4 KB from EOF failed; a
+ *     legitimately small (205 KB) bundle failed the size floor.
+ * Content sniffing cannot distinguish "real bundle" from "bytes that look like one",
+ * and it hard-codes one bundler's exact output shape.
+ *
+ * v3 therefore does NOT sniff content. Selection is a pure identity check:
+ *   - `dist/_webpack/BUILD.json` is the single source of truth, written by the SAME
+ *     build step that emits the artifact.
+ *   - It records `cacheVersion`, `filename`, `bytes` and a **sha256**.
+ *   - The runtime resolves exactly that path and verifies size + sha256.
+ *     Mismatch -> throw. No manifest -> throw. No scanning, no mtime, no guessing.
+ *
+ * This is deterministic, cannot be fooled by a plausible-looking file, has no false
+ * rejects for legitimately different bundles, and fails LOUDLY rather than serving junk.
+ * If a future build changes the bundle shape, nothing here needs to change — only the
+ * manifest, which is generated automatically.
+ */
+
+/** Name of the build manifest, written next to the cache directories. */
+const MANIFEST_NAME = 'BUILD.json';
 
 export default function getWebpackServeMiddleware() {
+    /**
+     * Resolved + verified prebuilt artifact, set by usePrebuiltLib().
+     * @type {{ outputPath: string, outputFile: string, size: number } | null}
+     */
+    let prebuilt = null;
+
+    /**
+     * Read and parse the build manifest.
+     *
+     * @param {string} distRoot
+     * @returns {{ cacheVersion?: string, filename?: string, bytes?: number, sha256?: string } | null}
+     */
+    function readBuildManifest(distRoot) {
+        const manifestPath = path.join(distRoot, MANIFEST_NAME);
+        try {
+            const raw = fs.readFileSync(manifestPath, 'utf8');
+            // Strip a UTF-8 BOM. Build/CI tooling on Windows emits one and JSON.parse
+            // rejects it — verified: JSON.parse throws "Unexpected token '\uFEFF'".
+            return JSON.parse(String(raw).replace(/^\uFEFF/, ''));
+        } catch (err) {
+            if (err?.code === 'ENOENT') {
+                return null;
+            }
+            throw new Error(
+                `[P1] ${manifestPath} exists but could not be parsed: ${err.message}. ` +
+                'Regenerate it with `node ./docker/build-lib.js`.',
+            );
+        }
+    }
+
+    /**
+     * Verify a candidate against the manifest's recorded identity.
+     *
+     * @param {string} libPath
+     * @param {{ bytes?: number, sha256?: string }} manifest
+     * @returns {{ ok: true } | { ok: false, reason: string }}
+     */
+    function verify(libPath, manifest) {
+        let stat;
+        try {
+            stat = fs.statSync(libPath);
+        } catch (err) {
+            return { ok: false, reason: `cannot stat: ${err.code ?? err.message}` };
+        }
+
+        if (!stat.isFile()) {
+            return { ok: false, reason: 'not a regular file' };
+        }
+
+        if (typeof manifest.bytes === 'number' && manifest.bytes >= 0 && stat.size !== manifest.bytes) {
+            return { ok: false, reason: `size mismatch: on disk ${stat.size} B, manifest says ${manifest.bytes} B` };
+        }
+
+        if (stat.size === 0) {
+            return { ok: false, reason: 'empty file' };
+        }
+
+        if (typeof manifest.sha256 === 'string' && manifest.sha256) {
+            let digest;
+            try {
+                digest = crypto.createHash('sha256').update(fs.readFileSync(libPath)).digest('hex');
+            } catch (err) {
+                return { ok: false, reason: `cannot hash: ${err.code ?? err.message}` };
+            }
+            if (digest !== manifest.sha256.toLowerCase()) {
+                return { ok: false, reason: `sha256 mismatch: on disk ${digest}, manifest ${manifest.sha256}` };
+            }
